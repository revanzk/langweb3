# Langflow API Configuration
# URL API Langflow yang aktif (lokal / hosting)
VITE_LANGFLOW_URL=http://localhost:7860
# API Key Langflow (opsional, isi jika flow membutuhkan x-api-key)
VITE_LANGFLOW_API_KEY=sk-aZxdItDf4Xi3LIA4AQkE5Yu2RgAacSaS-OeNUDE97Cw
# Flow ID 1: pencarian & scoring sponsor (RAG)
VITE_LANGFLOW_SEARCH_FLOW_ID=7a353363-d901-4e6f-8f33-ff3d06823b6d
# Flow ID 2: generate personalized draft email
VITE_LANGFLOW_DRAFT_FLOW_ID=45313891-9e4b-46c6-ab5a-dc56ef32e411
# Tampilkan panel "Debug Langflow" di dashboard (true/false, default true)
VITE_DEBUG_LANGFLOW=true
# Legacy (backward-compat, otomatis dipakai sebagai fallback bila SEARCH_FLOW_ID kosong)
VITE_LANGFLOW_FLOW_ID=

# Composio Configuration
# API Key Composio untuk FRONTEND (opsional, hanya indikator)
VITE_COMPOSIO_API_KEY=ak_BlkfLF3C251pUBVwJHWg
# URL backend pengirim email (Express, port 5000).
# Frontend selalu pakai base URL ini. Override bila backend pindah port/host.
VITE_COMPOSIO_BACKEND_URL=http://localhost:5000

# --- Backend only (dibaca server/index.js via dotenv, JANGAN pakai prefix VITE_) ---
# API Key Composio untuk pengiriman nyata (wajib agar /api/send-email berhasil)
COMPOSIO_API_KEY=ak_BlkfLF3C251pUBVwJHWg
# Opsional: entity ID Composio (default "default") dan port backend (default 5000)
# COMPOSIO_ENTITY_ID=default
# COMPOSIO_PORT=5000
