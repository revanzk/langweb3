//#region src/pagination.d.ts
/** A stable cursor value that can be compared across independently decoded pages. */
type PaginationCursor = string | number;
/** The position supplied to a paginated operation for one page request. */
interface PaginationRequest<Cursor extends PaginationCursor> {
  /** The continuation from the preceding response, absent on the first page. */
  readonly cursor: Cursor | undefined;
}
/** A standard Composio cursor page. */
interface CursorPage<Item> {
  readonly items: ReadonlyArray<Item>;
  readonly next_cursor?: string | null;
}
/** Extracts the item carried by a standard Composio cursor page. */
type CursorPageItem<Page> = Page extends CursorPage<infer Item> ? Item : never;
/** Fetches one page through a concrete SDK operation. */
type PageFetcher<Page, Cursor extends PaginationCursor> = (request: PaginationRequest<Cursor>) => PromiseLike<Page>;
/** Adapts an operation-specific response envelope to pagination. */
interface PaginationAdapter<Page, Item, Cursor extends PaginationCursor> {
  /** Returns the items carried by one response page. */
  readonly items: (page: Page) => ReadonlyArray<Item>;
  /** Returns the continuation for the next request, or nullish at the end. */
  readonly nextCursor: (page: Page) => Cursor | null | undefined;
}
/**
 * A lazy traversal of one SDK operation.
 *
 * Each iterator starts a fresh traversal. Pages are requested sequentially and
 * only on demand, so breaking out of iteration does not request another page.
 * The supplied operation remains responsible for its query, page size, request
 * options, cancellation, and normal client retry behavior.
 */
interface Pagination<Item, Page> extends AsyncIterable<Item> {
  [Symbol.asyncIterator](): AsyncIterableIterator<Item>;
  /** Iterates complete response pages without flattening their items. */
  iterPages(): AsyncIterable<Page>;
  /** Collects every item into memory. Prefer iteration for large collections. */
  toArray(): Promise<Array<Item>>;
}
/**
 * Lazily traverses a standard Composio `items` / `next_cursor` operation.
 *
 * @example
 * ```ts
 * const tools = paginate(({ cursor }) =>
 *   client.tools.list({ ...filters, cursor, limit: 1000 }),
 * )
 *
 * for await (const tool of tools) console.log(tool.slug)
 * ```
 */
declare function paginate<Page extends CursorPage<unknown>>(fetchPage: PageFetcher<Page, string>): Pagination<CursorPageItem<Page>, Page>;
/** Lazily traverses an operation with an operation-specific response envelope. */
declare function paginate<Page, Item, Cursor extends PaginationCursor>(fetchPage: PageFetcher<Page, Cursor>, adapter: PaginationAdapter<Page, Item, Cursor>): Pagination<Item, Page>;
//#endregion
export { CursorPage, CursorPageItem, PageFetcher, Pagination, PaginationAdapter, PaginationCursor, PaginationRequest, paginate };