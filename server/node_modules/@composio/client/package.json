{
  "name": "@composio/client",
  "version": "2.0.0-rc.8",
  "description": "Composio API client for TypeScript, generated from the v3.1 OpenAPI spec with hey-api",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:ComposioHQ/composio-client",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./pagination": {
      "types": "./dist/pagination.d.mts",
      "default": "./dist/pagination.mjs"
    },
    "./pagination.js": {
      "types": "./dist/pagination.d.mts",
      "default": "./dist/pagination.mjs"
    },
    "./pagination.mjs": {
      "types": "./dist/pagination.d.mts",
      "default": "./dist/pagination.mjs"
    },
    "./resources": {
      "types": "./dist/resources/index.d.mts",
      "default": "./dist/resources/index.mjs"
    },
    "./resources.js": {
      "types": "./dist/resources/index.d.mts",
      "default": "./dist/resources/index.mjs"
    },
    "./resources.mjs": {
      "types": "./dist/resources/index.d.mts",
      "default": "./dist/resources/index.mjs"
    },
    "./resources/*.js": {
      "types": "./dist/resources/*.d.mts",
      "default": "./dist/resources/*.mjs"
    },
    "./resources/*.mjs": {
      "types": "./dist/resources/*.d.mts",
      "default": "./dist/resources/*.mjs"
    },
    "./resources/*": {
      "types": "./dist/resources/*.d.mts",
      "default": "./dist/resources/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.17.0 <25",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "codegen preflight && openapi-ts && codegen compat",
    "generate:python": "openapi-python -f python/openapi-python.config.ts && codegen python",
    "codegen:check": "codegen compat --check && codegen python --check",
    "refresh-spec": "./scripts/refresh-spec.sh",
    "build": "tsdown",
    "benchmark": "pnpm build && node --experimental-transform-types scripts/benchmark.ts",
    "benchmark:baseline": "pnpm build && rm -rf .artifacts/benchmark/baseline && mkdir -p .artifacts/benchmark && cp -R dist .artifacts/benchmark/baseline",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.type-tests.json && tsgo --noEmit -p packages/codegen && tsgo --noEmit -p packages/parity && tsgo --noEmit -p demo",
    "typecheck:tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.type-tests.json && tsc --noEmit -p packages/codegen && tsc --noEmit -p packages/parity && tsc --noEmit -p demo",
    "lint": "eslint src test packages/codegen/src packages/codegen/test packages/parity/src packages/parity/test demo/run.ts demo/typescript",
    "test": "vitest run --project unit --project codegen --project parity --project demo",
    "test:pack": "./scripts/pack-check.sh",
    "test:contract": "vitest run --project contract",
    "test:parity:live": "pnpm build && node --experimental-transform-types packages/parity/src/main.ts",
    "test:parity:live:python": "cd python && rm -rf dist && uv build && cd .. && node --experimental-transform-types packages/parity/src/main.ts --language python",
    "deprecation-probe": "node --env-file=.env --experimental-transform-types scripts/deprecation-probe.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@composio/codegen": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-python": "0.0.0-next-20260729142554",
    "@hey-api/openapi-ts": "0.0.0-next-20260729142554",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260703.1",
    "@vitest/eslint-plugin": "^1.6.26",
    "composio-client-stainless": "npm:@composio/client@0.1.0-alpha.76",
    "eslint": "^9.39.4",
    "msw": "^2.15.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
